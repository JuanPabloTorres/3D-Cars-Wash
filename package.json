{
  "name": "febles-carwash-world",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run --config config/testing/vitest.config.ts",
    "test:e2e": "playwright test",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node dist-server/start.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"config/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"config/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,json}\""
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "jose": "6.2.13",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "latest",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "latest",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "latest"
  }
}
